<?xml version="1.0" encoding="UTF-8"?>
<redxml>
	<definitions>
		<abilities>
			<!-- ######################## gunforgeralt: AK-47 ######################## -->
			<!-- based on "Crossbow 1 _Stats" (def_item_weapons_crossbow.xml:9-12) -->
			<!-- no attack_power: the AK bullet damage is set by script (gfg_ak47.ws GfgSetAkDamage; item 10, 2026-10-16) -->
			<!-- ammo = magazine size 30 (CS2 m_iMaxClip1); vanilla scripts never read it (inventoryComponent.ws:4165) -->
			<ability name="gfg_ak47 _Stats">
				<tags></tags>
				<ammo type="add" min="30" />
			</ability>

			<!-- ######################## gunforgeralt: M4A1 (item 49, 2026-10-20; CS2 weapon_m4a1) ######################## -->
			<!-- same as the AK: damage by script (gfg_gun_m4a1.ws), ammo = magazine size 30 (CS2 m_iMaxClip1) -->
			<ability name="gfg_m4a1 _Stats">
				<tags></tags>
				<ammo type="add" min="30" />
			</ability>
		</abilities>

		<items>
			<!-- M1 placeholder: copied from "Crossbow 1" (def_item_weapons_crossbow.xml:103-127) -->
			<!-- weight 3.5 (vanilla 1.53) makes it easy to tell this item apart in the tooltip -->
			<!-- M3: equip_template = file name of dlc\gunforgeralt\data\items\weapons\gfg_ak47\gfg_ak47.w2ent (copy of witcher_crossbow_lvl1 with the AK mesh), mounted by test.reddlc -->
			<item
				name							="gfg_ak47"
				category						="crossbow"
				price							="100"
				weight							="3.5"
				enhancement_slots				="0"
				ability_slots					="0"
				grid_size						="2"
				hold_slot						="l_weapon"
				equip_template					="gfg_ak47"
				equip_slot						="gfg_ak47_back_slot"
				localisation_key_name			="gfg_item_name_ak47"
				localisation_key_description	="item_desc_crossbow_1"
				icon_path						="icons/inventory/weapons/gfg_ak47_64x128.png"
			>
				<!-- gfg_ak47 tag: scripts use it to recognise the AK (workspace/scripts/local/gfg_ak47.ws) -->
				<tags>							Weapon, crossbow, mod_weapon, gfg_ak47, gfg_gun
				</tags>
				<base_abilities>				<a>Default weapon _Stats</a>
												<a>gfg_ak47 _Stats</a>
				</base_abilities>
			</item>

			<!-- item 27 (2026-10-18): the AK's ammo (7.62x39mm), copied from "Bodkin Bolt" (def_item_bolts.xml:123-141) -->
			<!-- scripts equip it instead of the vanilla infinite bolt while the AK is the ranged weapon (gfg_ak47.ws "AK 的子彈") -->
			<!-- hold_template = gfg_ak47_bullet.w2ent (copy of bodkin_bolt.w2ent with the CS2 bullet head): the round loaded in the gun and the fired projectile -->
			<!-- gfg_ak47_ammo tag: scripts use it to recognise both ammo items -->
			<item
				name							="gfg_ak47_ammo"
				category						="bolt"
				price							="0"
				weight							="0.1"
				stackable						="1"
				grid_size						="2"
				hold_template					="gfg_ak47_bullet"
				localisation_key_name			="gfg_item_name_ak47_ammo"
				localisation_key_description	="gfg_item_desc_ak47_ammo"
				icon_path						="icons/inventory/weapons/gfg_ak47_ammo_64x128.png"
			>
				<tags>							WeaponTab, InfiniteAmmo, GroundAmmo, bolt, NoDrop, mod_noprice, mod_nosale, gfg_ak47_ammo, gfg_gun_ammo
				</tags>
				<base_abilities>				<a>bodkin_bolt _Stats</a>
												<a>Default weapon _Stats</a>
				</base_abilities>
			</item>

			<!-- underwater: vanilla switches to "Harpoon Bolt" when swimming or diving (playerWitcher.ws:5663-5676) → the AK switches to this one -->
			<!-- copied from "Harpoon Bolt" (def_item_bolts.xml:143-161): stats, UnderwaterAmmo tag -->
			<item
				name							="gfg_ak47_ammo_water"
				category						="bolt"
				price							="134"
				weight							="0.1"
				stackable						="1"
				grid_size						="2"
				hold_template					="gfg_ak47_bullet"
				localisation_key_name			="gfg_item_name_ak47_ammo"
				localisation_key_description	="gfg_item_desc_ak47_ammo"
				icon_path						="icons/inventory/weapons/gfg_ak47_ammo_64x128.png"
			>
				<tags>							WeaponTab, InfiniteAmmo, UnderwaterAmmo, bolt, NoDrop, mod_noprice, mod_nosale, gfg_ak47_ammo, gfg_gun_ammo
				</tags>
				<base_abilities>				<a>harpoon_bolt _Stats</a>
												<a>Default weapon _Stats</a>
				</base_abilities>
			</item>

			<!-- item 49 (2026-10-20): M4A1 = copy of gfg_ak47 (the gfg_gun tag makes every script treat it as our gun; values in gfg_gun_m4a1.ws) -->
			<!-- equip_template = dlc\gunforgeralt\data\items\weapons\gfg_m4a1\gfg_m4a1.w2ent; equip_slot: the AK's back slot (defined in test.reddlc) is reused -->
			<item
				name							="gfg_m4a1"
				category						="crossbow"
				price							="100"
				weight							="3.4"
				enhancement_slots				="0"
				ability_slots					="0"
				grid_size						="2"
				hold_slot						="l_weapon"
				equip_template					="gfg_m4a1"
				equip_slot						="gfg_ak47_back_slot"
				localisation_key_name			="gfg_item_name_m4a1"
				localisation_key_description	="item_desc_crossbow_1"
				icon_path						="icons/inventory/weapons/gfg_m4a1_64x128.png"
			>
				<tags>							Weapon, crossbow, mod_weapon, gfg_m4a1, gfg_gun
				</tags>
				<base_abilities>				<a>Default weapon _Stats</a>
												<a>gfg_m4a1 _Stats</a>
				</base_abilities>
			</item>

			<!-- the M4A1's ammo (5.56mm): copies of the AK ammo; the fired projectile reuses gfg_ak47_bullet (too small and fast to tell apart) -->
			<item
				name							="gfg_m4a1_ammo"
				category						="bolt"
				price							="0"
				weight							="0.1"
				stackable						="1"
				grid_size						="2"
				hold_template					="gfg_ak47_bullet"
				localisation_key_name			="gfg_item_name_m4a1_ammo"
				localisation_key_description	="gfg_item_desc_m4a1_ammo"
				icon_path						="icons/inventory/weapons/gfg_m4a1_ammo_64x128.png"
			>
				<tags>							WeaponTab, InfiniteAmmo, GroundAmmo, bolt, NoDrop, mod_noprice, mod_nosale, gfg_gun_ammo
				</tags>
				<base_abilities>				<a>bodkin_bolt _Stats</a>
												<a>Default weapon _Stats</a>
				</base_abilities>
			</item>

			<item
				name							="gfg_m4a1_ammo_water"
				category						="bolt"
				price							="134"
				weight							="0.1"
				stackable						="1"
				grid_size						="2"
				hold_template					="gfg_ak47_bullet"
				localisation_key_name			="gfg_item_name_m4a1_ammo"
				localisation_key_description	="gfg_item_desc_m4a1_ammo"
				icon_path						="icons/inventory/weapons/gfg_m4a1_ammo_64x128.png"
			>
				<tags>							WeaponTab, InfiniteAmmo, UnderwaterAmmo, bolt, NoDrop, mod_noprice, mod_nosale, gfg_gun_ammo
				</tags>
				<base_abilities>				<a>harpoon_bolt _Stats</a>
												<a>Default weapon _Stats</a>
				</base_abilities>
			</item>
		</items>
	</definitions>
</redxml>
